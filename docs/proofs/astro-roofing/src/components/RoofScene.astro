---
// Hero art: a standing-seam metal roof in perspective under valley rain. Drawn, not a stock photo.
const W = 1440, H = 900;
const ribs = Array.from({ length: 34 }, (_, i) => {
  const t = i / 33;
  const xb = -260 + t * 2100;          // bottom edge, spread wide (near the viewer)
  const xt = 120 + t * 1320;           // ridge line, closer together (far away)
  const yt = 560 - t * 170;            // ridge rises to the right
  return { xb, xt, yt, lit: i % 6 === 2 };
});
---
<svg class="absolute inset-0 h-full w-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b1f3a" />
      <stop offset=".55" stop-color="#1d2934" />
      <stop offset="1" stop-color="#2a3946" />
    </linearGradient>
    <linearGradient id="metal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a4a58" />
      <stop offset="1" stop-color="#151f28" />
    </linearGradient>
    <linearGradient id="sheen" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#e8ecef" stop-opacity="0" />
      <stop offset=".62" stop-color="#e8ecef" stop-opacity=".10" />
      <stop offset="1" stop-color="#e8ecef" stop-opacity="0" />
    </linearGradient>
  </defs>
  <rect width={W} height={H} fill="url(#sky)" />
  <polygon points={`-260,${H} 120,560 1440,390 1440,${H}`} fill="url(#metal)" />
  <polygon points={`-260,${H} 120,560 1440,390 1440,${H}`} fill="url(#sheen)" />
  {ribs.map(r => <line x1={r.xb} y1={H} x2={r.xt} y2={r.yt} stroke={r.lit ? '#8796a3' : '#0e171f'} stroke-width={r.lit ? 2.2 : 3} stroke-opacity={r.lit ? .55 : .9} />)}
  <line x1="120" y1="560" x2="1440" y2="390" stroke="#9aa7b2" stroke-width="5" stroke-opacity=".5" />
</svg>
<div class="rain" aria-hidden="true"><span></span><span></span><span></span></div>
<div class="scrim" aria-hidden="true"></div>

<style>
  .rain, .rain span { position: absolute; inset: 0; pointer-events: none; }
  /* three depth layers, three speeds: nearer rain is longer, brighter and faster (quality bar: 3+ depth layers) */
  .rain span { animation: fall linear infinite; }
  .scrim { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(11, 31, 58, .78) 0%, rgba(11, 31, 58, .45) 42%, rgba(11, 31, 58, 0) 70%); }
